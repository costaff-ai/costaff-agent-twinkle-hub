# =============================================================================
# CoStaff — Twinkle Hub Agent Configuration
# =============================================================================
# Instructions:
#   1. Copy this file to .env  →  cp .env.template .env
#   2. Fill in TWINKLE_HUB_API_KEY (from organizer / hub.twinkleai.tw /login)
#   3. Fill in GOOGLE_API_KEY (or switch provider to litellm below)
# =============================================================================

# -----------------------------------------------------------------------------
# Twinkle Hub MCP  [REQUIRED]
# -----------------------------------------------------------------------------
TWINKLE_HUB_API_KEY=
# Override only if Twinkle Hub publishes a new endpoint
# TWINKLE_HUB_MCP_URL=https://api.twinkleai.tw/mcp/

# -----------------------------------------------------------------------------
# AI MODEL  [REQUIRED — pick one provider]
# -----------------------------------------------------------------------------

# Active provider: "gemini" or "litellm"
COSTAFF_AGENT_MODEL_PROVIDER=gemini

# -- Option A: Google Gemini (default) ---------------------------------------
GOOGLE_API_KEY=
TWINKLE_HUB_AGENT_MODEL=gemini-2.5-flash

# -- Option B: LiteLLM -------------------------------------------------------
LITELLM_API_BASE=
LITELLM_API_KEY=
LITELLM_MODEL_NAME=
